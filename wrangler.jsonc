{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shutten-fuda",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-07-29",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "shutten-fuda.yhay81.com",
      "custom_domain": true,
    },
  ],
  "triggers": {
    "crons": ["43 19 * * *"],
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shutten-fuda",
      "database_id": "909bda1e-9de2-4405-b6c1-bf694820f690",
      "migrations_dir": "migrations",
    },
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
  },
}
